#!/usr/bin/env bash
# Creates the test role and database that scripts/check expects. Safe to re-run.
set -u
sudo -u postgres psql -tc "SELECT 1 FROM pg_roles WHERE rolname='test'" | grep -q 1 \
  || sudo -u postgres psql -c "CREATE ROLE test LOGIN SUPERUSER PASSWORD 'test'"
sudo -u postgres psql -tc "SELECT 1 FROM pg_database WHERE datname='test'" | grep -q 1 \
  || sudo -u postgres createdb -O test test
