# PostgreSQL configuration
POSTGRES_DB=heimdall
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=change_me

# Frontend API configuration
HEIMDALL_API_URL=http://localhost:8000

# Temporary WebSocket configuration for the frontend prototype
HEIMDALL_WS_URL=ws://localhost:8000/ws/events

# JWT authentication configuration
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
ENABLE_USER_REGISTRATION=true
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=50
LOGIN_FAILURE_WINDOW_SECONDS=900
